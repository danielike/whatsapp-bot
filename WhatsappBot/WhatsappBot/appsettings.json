{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConfigurationOptions": {
    "ForbiddenGenres": [
      "YourGenre",
      "YourGenre2",
      "YourGenre3"
    ],
    "FlaresolverrUrl": "http://localhost:8191/v1",
    "SiteUrl":"yourUrlRandom",
    "NameSelector": "meta[property=\"article:section\"]",
    "GenresSelector": "meta[property=\"article:tag\"]",
    "EvolutionApiUrl": "http://localhost:8082",
    "EvolutionApiInstance": "Bot",
    "EvolutionApiKey": "BQYHJGJHJ",
    "EvolutionApiSendMessageEndpoint": "/message/sendText",
    "EvolutionApiSendMessageId": "yourId",
    "EvolutionApiTranscriberUrl": "http://localhost:4040",
    "EvolutionApiTranscriberEndpoint": "/transcribe",
    "EvolutionApiTranscriberKey": "429683C4C977415CAAFCCE10F7D57E11",
    "GenerateRandomContentEnabled": true,
    "TranscribeAudioEnabled": true,
    "AllowedJids": [
      "1234",
      "1234",
      "120363428730667729"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}

